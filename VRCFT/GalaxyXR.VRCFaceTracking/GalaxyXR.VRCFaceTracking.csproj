<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <VRCFTCorePath Condition="'$(VRCFTCorePath)' == ''">$(MSBuildThisFileDirectory)..\..\ThirdParty\VRCFaceTracking\5.2.3.0\VRCFaceTracking.Core.dll</VRCFTCorePath>
    <VRCFTSdkPath Condition="'$(VRCFTSdkPath)' == ''">$(MSBuildThisFileDirectory)..\..\ThirdParty\VRCFaceTracking\5.2.3.0\VRCFaceTracking.SDK.dll</VRCFTSdkPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VRCFaceTracking.Core">
      <HintPath>$(VRCFTCorePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRCFaceTracking.SDK">
      <HintPath>$(VRCFTSdkPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireVRCFTCore" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VRCFTCorePath)')" Text="VRCFaceTracking.Core.dll 5.2.3.0 was not found. Run tools\Acquire-VRCFT-5.2.3-SDK.ps1 or set VRCFTCorePath." />
    <Error Condition="!Exists('$(VRCFTSdkPath)')" Text="VRCFaceTracking.SDK.dll 5.2.3.0 was not found. Run tools\Acquire-VRCFT-5.2.3-SDK.ps1 or set VRCFTSdkPath." />
  </Target>
</Project>
